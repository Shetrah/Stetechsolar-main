# Server-side values only. Copy to .env.local for local development.
ADMIN_PASSWORD=replace-with-a-long-unique-password
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# Optional AI provider. Without a key, the assistant uses built-in solar guidance.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
SITE_URL=

# Firebase Admin credentials for the Vercel API (server-side only).
# Create a service account with Firestore and Firebase Storage access, then paste
# its complete JSON as a single environment-variable value. Never commit the key.
FIREBASE_PROJECT_ID=stetech-solar
FIREBASE_STORAGE_BUCKET=stetech-solar.firebasestorage.app
FIREBASE_SERVICE_ACCOUNT_JSON=
