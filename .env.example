# Optional server-side settings. Direct admin data access uses Firebase client auth/rules.
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# Optional AI provider. Without a key, the assistant uses built-in solar guidance.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
SITE_URL=

# Optional Firebase Admin credentials for server-only API features such as solar chat.
# Admin portal login and Firestore/Storage access do not use this service account.
FIREBASE_PROJECT_ID=stetech-solar
FIREBASE_STORAGE_BUCKET=stetech-solar.firebasestorage.app
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_ADMIN_EMAILS=admin@example.com
